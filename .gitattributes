# Normalise line endings so a Windows editor rewriting a file does not show up
# as a whole-file diff. Git stores LF; Windows checkouts still get CRLF where
# the platform expects it.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
