{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glass-docs",
  "compatibility_date": "2026-07-18",
  "build": {
    "command": "npm run build:static"
  },
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}